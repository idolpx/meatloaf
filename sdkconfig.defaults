# This file was generated using idf.py save-defconfig. It can be edited manually.
# Espressif IoT Development Framework (ESP-IDF) 5.5.0 Project Minimal Configuration
#
CONFIG_BOOTLOADER_LOG_COLORS=y
#CONFIG_ESPTOOLPY_FLASHSIZE_16MB=y
#CONFIG_ESPTOOLPY_FLASHSIZE="16MB"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=2000000
CONFIG_CONSOLE_UART_CUSTOM=y
CONFIG_CONSOLE_UART_BAUDRATE=2000000
CONFIG_FATFS_LFN_HEAP=y
CONFIG_SPI_FLASH_DANGEROUS_WRITE_ALLOWED=y
CONFIG_MBEDTLS_ROM_MD5=n
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_FREERTOS_TASK_CREATE_ALLOW_EXT_MEM=y
CONFIG_HTTPD_WS_SUPPORT=y
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_USE_STATS_FORMATTING_FUNCTIONS=y
CONFIG_ESP_INT_WDT_TIMEOUT_MS=800
CONFIG_ESP_TASK_WDT=n
CONFIG_BOOTLOADER_SKIP_VALIDATE_ON_POWER_ON=y
CONFIG_ESP_TLS_INSECURE=y
CONFIG_ESP_TLS_SKIP_SERVER_CERT_VERIFY=y
CONFIG_ESP_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_HTTPS=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_BASIC_AUTH=y
CONFIG_ESP_HTTP_CLIENT_ENABLE_DIGEST_AUTH=y
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024

#
# ESP PSRAM
#
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_OCT=y
CONFIG_SPIRAM_TYPE_AUTO=y
CONFIG_SPIRAM_CLK_IO=30
CONFIG_SPIRAM_CS_IO=26
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_SPEED=80
CONFIG_SPIRAM_BOOT_INIT=y
CONFIG_SPIRAM_USE_MALLOC=y
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=128
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y
CONFIG_SPIRAM_MALLOC_RESERVE_INTERNAL=32768
CONFIG_SPIRAM_ALLOW_BSS_SEG_EXTERNAL_MEMORY=y
CONFIG_SPIRAM_ALLOW_NOINIT_SEG_EXTERNAL_MEMORY=y
# end of ESP PSRAM

# WiFi driver buffer tuning — esp_wifi_init() is the single largest internal-RAM
# consumer at boot (measured ~66 KB on a PSRAM board at stock ESP-IDF settings,
# and collapses the largest contiguous free block by a similar amount, which is
# what starves later task-stack allocations like httpd/console_exec). Values
# below are either the plain ESP-IDF default (TX_BA_WIN, DYNAMIC_RX_BUFFER_NUM —
# these boards had drifted above default) or a deliberate reduction below it
# (STATIC_RX/TX_BUFFER_NUM, CACHE_TX_BUFFER_NUM, MGMT_SBUF_NUM), verified on
# hardware (lolin-d32-pro) to free ~24 KB total with no observed WiFi throughput
# regression. RX_BA_WIN=16 matches ESP-IDF's own PSRAM-aware default (6 without
# PSRAM) — non-PSRAM boards should set RX_BA_WIN=6 in their board sdkconfig.
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP_WIFI_STATIC_TX_BUFFER_NUM=10
CONFIG_ESP_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP_WIFI_TX_BA_WIN=6
CONFIG_ESP_WIFI_RX_BA_WIN=16
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
CONFIG_ESP32_WIFI_STATIC_RX_BUFFER_NUM=10
CONFIG_ESP32_WIFI_DYNAMIC_RX_BUFFER_NUM=32
CONFIG_ESP32_WIFI_STATIC_TX_BUFFER_NUM=10
CONFIG_ESP32_WIFI_CACHE_TX_BUFFER_NUM=16
CONFIG_ESP32_WIFI_TX_BA_WIN=6
CONFIG_ESP32_WIFI_RX_BA_WIN=16
CONFIG_ESP32_WIFI_MGMT_SBUF_NUM=16

CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ=240
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=4096

# Meatloaf.reloadAllConfig() runs inline on the "main" task (before it deletes
# itself in app_main()) to restore each drive's persisted mounted URL at boot,
# including local SD/D64 paths — the same deep-stack MFile/PeoplesUrlParser
# resolution chain that reload_network_drives_task already needs 16384 bytes
# for (see src/main.cpp). The ESP-IDF default (3584) is too small and overflows
# on long SD paths.
CONFIG_ESP_MAIN_TASK_STACK_SIZE=16384
CONFIG_MAIN_TASK_STACK_SIZE=16384

# HAGL display pins — set to -1 so boards without a wired display don't get GPIO conflicts
# Boards with a display override these in their board-specific sdkconfig
CONFIG_MIPI_DISPLAY_PIN_MOSI=-1
CONFIG_MIPI_DISPLAY_PIN_CLK=-1
CONFIG_MIPI_DISPLAY_PIN_CS=-1
CONFIG_MIPI_DISPLAY_PIN_DC=-1
CONFIG_MIPI_DISPLAY_PIN_RST=-1
CONFIG_MIPI_DISPLAY_PIN_BL=-1

# Wear-levelling sector size. This project never uses wear levelling - internal
# flash is LittleFS and no partition table declares a FAT partition - but this
# value still drives FatFs: FF_MAX_SS = MAX(FF_SS_SDCARD, FF_SS_WL), and
# FF_SS_SDCARD is hardcoded 512. At 4096 it made every FatFs buffer 8x larger
# than an SD card needs, and with CONFIG_FATFS_PER_FILE_CACHE=y (FF_FS_TINY=0)
# that is a per-OPEN-FILE cost in internal DRAM, not a one-off. SQLite holding
# its db plus a DELETE-mode rollback journal open then ran the DMA-capable heap
# down far enough that sdmmc_write_sectors() failed with ESP_ERR_NO_MEM.
CONFIG_WL_SECTOR_SIZE_512=y
# CONFIG_WL_SECTOR_SIZE_4096 is not set
CONFIG_WL_SECTOR_SIZE=512
