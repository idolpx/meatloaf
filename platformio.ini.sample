; Meatloaf PlatformIO Project Configuration File
;
; Quick Start Instructions:
;
;   Set the following options in this file:
;       in [meatloaf] section: Set your environment and flash_size
;       in [env] section: Set your upload_port and monitor_port
;
;   To build in VSCode, select the PlatformIO icon on the sidebar and expand
;   the section for the board you have chosen (ie, lolin-d32). First, choose
;   choose Upload under the General section, then choose Upload Filesystem 
;   image under the Platform section.
;
; Please visit documentation for the other options and examples
; https://docs.platformio.org/page/projectconf.html

[meatloaf]
description = The internet is a massive floppy drive for your C64 with Meatloaf!

; Uncomment ONLY ONE of the below lines to target the hardware you use
; GPIO pin assignments are located in the include/pinmap/ directory for reference

; ESP32-WROVER
;environment = iec-nugget                   ; Wemos Lolin D32 Pro                         (ESP32-WROVER, 16M Flash, 8M PSRAM)
;environment = lolin-d32-pro                ; Wemos Lolin D32 Pro                         (ESP32-WROVER, 16M Flash, 8M PSRAM)
;environment = fujiapple-rev0               ; FujiApple REV0 with esp32-devkitc           (ESP32-WROVER 8M PSRAM, 8M Flash)
;environment = fujinet-v16                  ; FujiNet v1.6                                (ESP32-WROVER, 16M Flash, 8M PSRAM)
;environment = fujiloaf-rev0                ; Meatloaf / FujiNet REV0 board, aka Fujiloaf (ESP32-WROVER, 16M Flash, 8M PSRAM)
;environment = freenove-esp32-cam           ; Freenove ESP32 CAM Board                    (ESP32-WROVER, 4M Flash, 8M PSRAM)

; ESP32-WROOM32
;environment = esp32-wroom32                ; generic esp32-wroom32 board                 (ESP32-WROOM32, 4M Flash, NO PSRAM)
;environment = esp32-wroom32-pi1541         ; generic esp32-wroom32 board with pi1541     (ESP32-WROOM32, 4M Flash, NO PSRAM)
;environment = ttgo-t1                      ; Lilygo TTGO T1 V1.3                         (ESP32, 4M Flash, NO PSRAM)
;environment = petdiskmaxv2                 ; PETDisk MAX V2.9                            (ESP32-WROOM32, 4M Flash, NO PSRAM)
;environment = wic64                        ; WiC64 WiFi Adapter                          (ESP32-WROOM32, 4M Flash, NO PSRAM)

; EXPERIMENTAL
; ESP32-S2
;environment = lolin-s2-mini                ; Wemos Lolin S2 Mini                         (ESP32-S3, 4M Flash, 2M PSRAM)

; ESP32-S3
;environment = esp32-s3-devkitc-1           ; esp32s3 devkitc                             (ESP32-S3, 8M Flash, 8M PSRAM)
;environment = lolin-s3-pro                 ; Wemos Lolin S3 Pro                          (ESP32-S3, 16M Flash, 8M PSRAM)
;environment = foenix-s3-pro                ; Foenix S3 ML                                (ESP32-S3, 16M Flash, 8M PSRAM)
;environment = freenove-esp32-s3-wroom-1    ; Freenove ESP32-S3-WROOM-1                   (ESP32-S3, 16M Flash, 8M PSRAM)
;environment = lilygo-t-display-s3          ; LilyGO T-Display S3                         (ESP32-S3, 16M Flash, 8M PSRAM)
;environment = esp32-1732s019               ; ESP32-1732S019 ST7789.                      (ESP32-S3, 16M Flash, 8M PSRAM)
;environment = esp32-s3-zero                ;                                             (ESP32-S3, 4M Flash, 2M PSRAM)
;environment = esp32-s3-super-mini          ;                                             (ESP32-S3, 4M Flash, 2M PSRAM)
;environment = adafruit_feather_esp32s3_tft ; Adafruit ESP32-S3 TFT Feather               (ESP32-S3, 4M Flash, 2M PSRAM)
;environment = esp32-s3-rgb                 ;                                             (ESP32-S3, 16M Flash, 8M PSRAM)
;environment = esp32-s3-dev-kit-n8r8        ; Waveshare ESP32-S3                          (ESP32-S3, 8M Flash, 8M PSRAM)
;environment = esp32-s3-makemagazin         ; Make Magazin Germany ESP32-S3-DevKitC-1     (ESP32-S3, 8M Flash, 8M PSRAM)

; EXPERIMENTAL
; ESP32-C3
;environment = esp32-c3-super-mini          ;                                             (ESP32-C3, 4M Flash, NO PSRAM)

; EXPERIMENTAL
; ESP32-P4
;environment = waveshare-p4-module-dev-kit  ; Waveshare ESP32-P4-Module-Dev-Kit           (ESP32-P4, 16M Flash, 32M PSRAM)
;environment = wt9932p4-tiny                ; Weijing WT9932P4 Tiny Board                 (ESP32-P4, 16M Flash, 32M PSRAM)

; NATIVE UNIT TESTING
;environment = native                       ; For running tests that don't require embedded hardware

;*** NO NEED TO SET THIS NOW, IT WILL BE SET AUTOMATICALLY BASED ON THE ENVIRONMENT YOU SELECT ABOVE ***
;Set flash size to 4M, 8M, 16M or 32M according to the enviornment you selected above
;flash_size = 4m
;flash_size = 8m
;flash_size = 16m
;flash_size = 32m

; Choose SPIFFS or LITTLEFS for the filesystem used on internal flash
;flash_filesystem = FLASH_SPIFFS
flash_filesystem = FLASH_LITTLEFS

; Set default WiFi credentials
wifi_ssid = "meatloaf"
wifi_pass = "meatloaf"

; Address of the Ultimate 64 / Ultimate II+ REST API, used by the C64 debug
; tooling in .claude/skills/commodore64-debugging. Not compiled into the
; firmware. The U64_IP_ADDRESS environment variable overrides it.
u64_ip_address = 192.168.1.64

; Required flags, leave as is
build_platform = BUILD_IEC

[platformio]
description = ${meatloaf.description}
default_envs = ${meatloaf.environment}
;default_envs = lolin-d32-pro, iec-nugget, fujiloaf-rev0, freenove-esp32-s3-wroom-1, foenix-s3-ml
;default_envs = wic64 petdiskmaxv2
;data_dir = data/${meatloaf.build_platform}.${meatloaf.flash_size}

[esp32_base]
; Espressif32 PlatformIO Version to use for building
; https://github.com/platformio/platform-espressif32/releases
platform = espressif32 @ 6.13.0
;platform = espressif32 @ 7.0.1
framework = espidf
board_build.filesystem = littlefs
test_filter = embedded/*
extra_scripts =
    pre:build_data.py
;    pre:build_version.py
;    pre:build_nvs.py
    ; Applies fixes to the ESP-IDF package that upstream has not released yet.
    ; Idempotent; see the script for what and why.
    pre:patch_framework.py
;    post:build_firmwarezip.py

[env]
; Common settings for all environments
build_type = debug ;debug ;release
lib_ldf_mode = off ; off chain deep chain+ deep+
upload_speed = 2000000 ;460800 ;921600 ;2000000
;upload_port = COM1 ; Windows
;upload_port = /dev/ttyUSB0 ; Linux
;upload_port = /dev/cu.usbserial-144210 ; Mac
monitor_speed = 2000000 ;460800 ;921600 ;2000000
;monitor_port = COM1 ; Windows
;monitor_port = /dev/ttyUSB0 ; Linux
;monitor_port = /dev/cu.usbserial-144210 ; Mac
monitor_filters = esp32_exception_decoder ;, time
check_skip_packages = yes
;debug_tool = esp-prog
;debug_init_break = tbreak setup

; Build flags used by ALL boards go here
build_flags =
    -std=gnu++17
    -D ${meatloaf.build_platform}
    -D ${meatloaf.flash_filesystem}
    -D CMAKE_EXPORT_COMPILE_COMMANDS=ON

    ; Default WiFi
    -D WIFI_SSID=\"${meatloaf.wifi_ssid}\"
    -D WIFI_PASSWORD=\"${meatloaf.wifi_pass}\"

    ; Firmware Version
    ;-D MEATLOAF_MAX

    ; IEC Hardware Options
    ; These options are also useful for reusing a PI1541 Hat with Meatloaf
    ;-D IEC_SPLIT_LINES     ; hardware uses seperate input/output lines
    ;-D IEC_INVERTED_LINES  ; hardware inverts the signals

    ; Other Hardware Options
    ;-D NO_BUTTONS          ; if your hardware has no physical buttons
    ;-D SD_CARD             ; if your hardware has an sd card slot
    ;-D CARD_DETECT_HIGH    ; SD card-detect line reads HIGH when a card is
                            ;  present (the default assumes active LOW)
    ;-D PARALLEL_BUS        ; if your hardware has userport parallel interface
    ;-D ENABLE_PARALLEL     ; parallel CABLE (not the userport bus). Defines the
                            ;  PIN_PARALLEL_* pins in the board pinmap, which is
                            ;  what makes IECConfig.h define IEC_SUPPORT_PARALLEL
                            ;  and enables the DolphinDOS / SpeedDOS fast loaders.
                            ;  Only some pinmaps define these pins - check yours.
    ;-D PARALLEL_BUS_X      ; legacy userport parallelBus class (lib/bus/userport).
                            ;  Superseded by PARALLEL_BUS; note parallel.cpp's own
                            ;  guard is commented out, so only the header and the
                            ;  main.cpp call site are actually gated.
    ;-D NO3STATE            ; FujiApple only: force the Apple II bus tri-state
                            ;  path on boards with no pull-down on IO21
    ;-D JTAG                ; enable use with JTAG debugger
    ;-D BLUETOOTH_SUPPORT   ; enable BlueTooth support

    ; Service Options
    ;-D ENABLE_ZIMODEM      ; enable Zimodem functionality
    ;-D ENABLE_SSDP         ; enable Simple Service Discovery Protocol service
    ;-D ENABLE_CONSOLE      ; enable console service
    ;-D ENABLE_CONSOLE_TCP  ; enable tcp server for console
    ;-D ENABLE_DISPLAY      ; enable display service
    ;-D ENABLE_AUDIO        ; enable audio service
    ;-D ENABLE_PS2          ; enable PS/2 keyboard support

    ; Feature Options
    ; These cost flash text rather than saving it - the opposite of the gates
    ; below. On an ESP32 (non-S3) board check the iram0_2_seg headroom before
    ; adding one.
    -D EXTRA_DISK_FORMATS  ; register the .arc/.sda, .g71, .g81 and .p81
                            ;  filesystems. Compiled either way; this only
                            ;  adds them to MFSOwner's list.
    -D EXTRA_FASTLOADERS   ; compile the fast loader IMPLEMENTATIONS
                            ;  (IEC_IMPL_SOFTLOAD). Detection is always built:
                            ;  without this a recognised loader is logged and
                            ;  declined, and the C64 falls back to the standard
                            ;  protocol. Also costs IRAM (iram0_0_seg) for the
                            ;  RAMFUNC byte codecs - a separate budget from
                            ;  flash text, see the gate notes below.
    ;-D USE_VDRIVE          ; device 30 (iecMeatloaf) starts with use_vdrive
                            ;  true instead of false

    ; Memory Options
    ;-D MIN_CONFIG
    ;-D DISABLE_DIRCACHE    ; stream FTP listings instead of caching them
                            ; (saves 272 bytes per entry of internal RAM on
                            ;  boards without PSRAM; loses sorting, listing
                            ;  re-use, and makes dir_seek() re-list)

    ; Feature Gates - each drops one large library from the link.
    ;
    ; A gate set HERE applies to every board; set one in an [env:...] section
    ; instead when only that board needs it. They exist to buy flash text: the
    ; ESP32 (non-S3) window (iram0_2_seg) is 3,342,304 bytes and is the binding
    ; constraint on those boards, while the S3 and P4 windows are large enough
    ; that no gate is needed. Every gate costs a real feature.
    ;
    ; Figures are .flash.text bytes measured on fujiloaf-rev0 (2026-08-25) by
    ; diffing the linker map of an all-gates build against the baseline, so
    ; they include the gated library AND the caller code that goes with it.
    ; The ten below free 1,067,152 bytes if all are set.
    ;
    ;-D DISABLE_LOCATEDB        ; 406,890 - sqlite3. Removes the 'updatedb' and
    ;                             'locate' console commands. Sits inside
    ;                             #ifdef SD_CARD, so frees nothing on a board
    ;                             with no SD slot.
    ;-D DISABLE_SSH             ; 139,761 - libssh. Removes sftp://, the N: SSH
    ;                             protocol, and mDNS _sftp-ssh discovery.
    ;-D DISABLE_TAPE            ; 119,284 - tapclean. Removes .tap/.dmp/.htap
    ;                             and the T-C / T-I drive commands. Tape decode
    ;                             effectively needs PSRAM anyway.
    ;-D DISABLE_NFS             ;  85,287 - libnfs. Removes nfs://.
    ;-D DISABLE_WEBDAV_CLIENT   ;  78,796 - expat. An N: HTTP PROPFIND listing
    ;                             yields no entries. The WebDAV SERVER in
    ;                             lib/www/ is untouched.
    -D DISABLE_RETROPIXELS     ;  75,494 - removes the retropixels: encoder
    ;                             (image conversion to C64 formats).
    -D DISABLE_ISCSI           ;  52,633 - libiscsi. Removes iscsi://.
    ;-D DISABLE_AFP             ;  48,810 - afpfs-ng. Removes afp://.
    ;-D DISABLE_ARCHIVE_7Z      ;  15,779 - libarchive's .7z reader.
    -D DISABLE_ARCHIVE_XAR      ;  12,071 - libarchive's .xar reader. A xar is
    ;                             an Apple installer container; nothing a
    ;                             Commodore meets, hence on by default.
    ;
    ; Gates already excluded by another flag are no-ops: the tape, sftp, nfs,
    ; afp and iscsi filesystems are all inside #ifndef MIN_CONFIG, so those
    ; five free nothing on a MIN_CONFIG board. DISABLE_LOCATEDB is inside
    ; #ifdef SD_CARD and frees nothing without an SD slot. RETROPIXELS,
    ; ARCHIVE_7Z and ARCHIVE_XAR are inside neither, so those three pay on
    ; every board.
    ;
    ; The two ARCHIVE gates drop libarchive's own reader objects and nothing
    ; else. They do NOT free libzstd (62 KB) or liblzma (18 KB), as was first
    ; assumed: libarchive's ZIP reader references both, for zip's zstd and
    ; xz/lzma compression methods, so those two archives are in every image
    ; that can read a .zip. Measured on the linker map, not assumed.

    ; GPIO Expander Selection (select only one if available)
    ;-D GPIOX_PCF8575           ; I2C - https://www.ti.com/product/PCF8575
    ;-D GPIOX_MCP23017          ; I2C - https://www.microchipdirect.com/product/MCP23017-E/SP
    ;-D GPIOX_MCP23S17          ; SPI - https://www.microchipdirect.com/product/MCP23S17-E/SP
    ;-D GPIOX_XRA1405           ; SPI - https://www.maxlinear.com/ds/xra1405.pdf

    ; DEBUG Options
    -D DEBUG_SPEED=${env.monitor_speed}
    ;-D DELAY_START_MILLIS=2000 ; allow time to connect to USB serial device
    ;-D DATA_STREAM
    ;-D VERBOSE_TNFS
    ;-D VERBOSE_DISK
    ;-D VERBOSE_HTTP
    ;-D VERBOSE_PROTOCOL
    ;-D DEBUG_TIMING
    ;-D NO_VIRTUAL_KEYBOARD
    ;-D DBUG2 ; enable monitor messages for a release build
    ;-D RUN_TESTS
    ;-D TOO_MUCH_DEBUG      ; per-accept logging in fnTcpServer
    ;-D UNIT_TESTS          ; #undef DEBUG in include/debug.h, silencing every
                            ;  Debug_print* macro
    ;-D CONFIG_MDNS_ENABLE_DEBUG_PRINTS

build_unflags =
    -std=gnu++11

[env:native]
; Add Code Coverage Reporting
; https://piolabs.com/blog/insights/test-coverage-on-unit-testing.html
; https://blog.leon0399.ru/platformio-coverage-github-actions
platform = native
test_filter = native/*
lib_deps = throwtheswitch/Unity@^2.6.1
extra_scripts =
    gen_coverage.py
    test/native/test_archive_extract/host/build_libarchive.py
build_flags =
    ${env.build_flags}
    -D TEST_NATIVE
    ; Header search paths for the disk-write engine sources pulled in by
    ; test/native/test_disk_write/engine_sources.cpp (see that file for why
    ; they're included directly instead of relying on PlatformIO's LDF).
    -I lib/meatloaf
    -I lib/utils
    ; test_archive_extract additionally compiles lib/utils/utils.cpp and
    ; lib/utils/peoples_url_parser.cpp, which need lib/compat and lib/sam.
    ; Its C dependencies (libarchive, zlib, bzip2, lz4) are built by the
    ; extra_script above - see that file for why they can't be unity-built.
    -I lib/compat
    -I lib/sam
    ; test_archive_extract: libarchive's public headers, and the host shims
    ; (mingw gaps, freertos/esp stubs, and the libarchive config override -
    ; see test/native/test_archive_extract/host/config.h).
    -I components/libarchive/lib
    ; test_nib_read: zlib's headers, for the gzip-compressed .nbz container.
    ; The library objects themselves are already linked - build_libarchive.py
    ; folds zlib into the single archive lib it prepends for every native suite.
    -I components/zlib/zlib
    ; test_ps2_keys: scan_codes_set_2.h (stdint.h only, native-safe).
    -I components/ps2/src
    -I test/native/test_archive_extract/host
    -include test/native/test_archive_extract/host/host_posix_compat.h
    ;-lgcov
    ;--coverage
    ;-fprofile-abs-path


; ESP32-WROVER
[env:fujiloaf-rev0]
extends = esp32_base
board = esp32-wrover-16m
build_flags =
    ${env.build_flags}
    -D PINMAP_FUJILOAF_REV0
    -D SD_CARD
    -D ENABLE_DISPLAY
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP
    ;-D ENABLE_BLUETOOTH
    ;-D PARALLEL_BUS
    ;-D GPIOX_PCF8575
    ;-D MEATLOAF_MAX
    ;-D ENABLE_SSDP

[env:lolin-d32-pro]
extends = esp32_base
board = esp32-wrover-16m
build_flags =
    ${env.build_flags}
    -D PINMAP_LOLIN_D32_PRO
    -D NO_BUTTONS
    -D SD_CARD
    -D ENABLE_DISPLAY
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP

[env:iec-nugget]
extends = esp32_base
board = esp32-wrover-16m
build_flags =
    ${env.build_flags}
    -D PINMAP_IEC_NUGGET
    -D NO_BUTTONS
    -D SD_CARD
    -D ENABLE_DISPLAY
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP

[env:fujiapple-rev0]
extends = esp32_base
board = esp32-wrover-8m
build_flags =
    ${env.build_flags}
    -D PINMAP_A2_REV0
    -D SD_CARD

[env:fujinet-v16]
extends = esp32_base
board = esp32-wrover-8m
build_flags =
    ${env.build_flags}
    -D PINMAP_FN_16
    -D SD_CARD

[env:freenove-esp32-cam]
extends = esp32_base
board = esp32-wrover-4m
board_build.partitions = boards/partitions.4m.csv
build_flags =
    ${env.build_flags}
    -D PINMAP_FREENOVE_ESP32_CAM
    -D NO_BUTTONS
    -D SD_CARD
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP

; ESP32-WROOM32
[env:esp32-wroom32]
extends = esp32_base
board = esp32-wroom32
build_flags =
    ${env.build_flags}
    -D PINMAP_WROOM32
    -D ENABLE_CONSOLE
    -D MIN_CONFIG
    -D DISABLE_DIRCACHE    ; no PSRAM: a cached listing exhausts internal RAM

[env:esp32-wroom32-pi1541]
extends = esp32_base
board = esp32-wroom32
build_flags =
    ${env.build_flags}
    -D PINMAP_WROOM32_1541
    -D NO_BUTTONS
    -D IEC_SPLIT_LINES
    -D IEC_INVERTED_LINES
    -D ENABLE_CONSOLE
    -D MIN_CONFIG
    -D DISABLE_DIRCACHE

[env:ttgo-t1]
extends = esp32_base
board = esp32-wroom32
build_flags =
    ${env.build_flags}
    -D PINMAP_TTGO_T1
    -D SD_CARD
    -D ENABLE_CONSOLE
    -D MIN_CONFIG
    -D DISABLE_DIRCACHE

[env:petdiskmaxv2]
extends = esp32_base
board = esp32-wroom32
build_flags =
    ${env.build_flags}
    -D PINMAP_PETDISKMAXV2
    -D NO_BUTTONS
    -D SD_CARD
    -D ENABLE_CONSOLE
    -D MIN_CONFIG
    -D DISABLE_DIRCACHE

[env:wic64]
extends = esp32_base
board = esp32-wroom32
build_flags =
    ${env.build_flags}
    -D PINMAP_WIC64
    -D ENABLE_CONSOLE
    -D MIN_CONFIG
    -D DISABLE_DIRCACHE
    -D PARALLEL_BUS

; ESP32-S2
[env:lolin-s2-mini]
extends = esp32_base
board = esp32-s2fh4
build_flags =
    ${env.build_flags}
    -D PINMAP_LOLIN_S2_MINI

; ESP32-S3
[env:esp32-s3-devkitc-1]
extends = esp32_base
board = esp32-s3-wroom-1-n8r8
build_flags =
    ${env.build_flags}
    -D PINMAP_ESP32S3_DEVKITC_1
    -D SD_CARD
    -D ENABLE_DISPLAY
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP

[env:esp32-s3-makemagazin]
extends = esp32_base
board = esp32-s3-wroom-1-n8r8
build_flags =
    ${env.build_flags}
    -D PINMAP_ESP32S3_MAKEMAGAZIN
    -D SD_CARD
    -D ENABLE_DISPLAY
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP

[env:lolin-s3-pro]
extends = esp32_base
board = esp32-s3-wroom-1-n16r8
build_flags =
    ${env.build_flags}
    -D PINMAP_LOLIN_S3_PRO
    -D SD_CARD
    -D ENABLE_DISPLAY
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP

[env:foenix-s3-ml]
extends = esp32_base
board = esp32-s3-wroom-1-n16r8
build_flags =
    ${env.build_flags}
    -D PINMAP_FOENIX_S3_ML
    -D SD_CARD
    -D ENABLE_DISPLAY
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP

[env:freenove-esp32-s3-wroom-1]
extends = esp32_base
board = esp32-s3-wroom-1-n16r8
build_flags = 
    ${env.build_flags}
    -D PINMAP_FREENOVE_ESP32S3
    -D SD_CARD
    -D ENABLE_DISPLAY
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP

[env:lilygo-t-display-s3]
extends = esp32_base
board = esp32-s3-wroom-1-n16r8
build_flags =
    ${env.build_flags}
    -D PINMAP_LILYGO_T_DISPLAY_S3
    -D SD_CARD
    -D ENABLE_DISPLAY
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP

[env:esp32-1732s019]
extends = esp32_base
board = esp32-s3-wroom-1-n16r8
build_flags = 
    ${env.build_flags}
    -D PINMAP_ESP32_1732S019
    -D SD_CARD
    -D ENABLE_DISPLAY
    -D ENABLE_DISPLAY
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP

[env:esp32-s3-zero]
extends = esp32_base
board = esp32-s3fh4r2
build_flags =
    ${env.build_flags}
    -D PINMAP_ESP32_S3_ZERO
    -D ENABLE_DISPLAY
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP

[env:esp32-s3-super-mini]
extends = esp32_base
board = esp32-s3fh4r2
build_flags =
    ${env.build_flags}
    -D PINMAP_ESP32_S3_SUPER_MINI
    -D NO_BUTTONS
    -D SD_CARD
    -D ENABLE_DISPLAY
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP

[env:adafruit_feather_esp32s3_tft]
extends = esp32_base
board =  esp32-s3fh4r2
build_flags =
    ${env.build_flags}
    -D PINMAP_ADAFRUIT_FEATHER_ESP32S3_TFT
    -D NO_BUTTONS
    -D ENABLE_DISPLAY
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP

[env:esp32-s3-rgb]
extends = esp32_base
board = esp32-s3-wroom-1-n16r8
build_flags = 
    ${env.build_flags}
    -D PINMAP_ESP32_S3_RGB
    -D SD_CARD
    -D ENABLE_DISPLAY
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP

[env:esp32-s3-dev-kit-n8r8]
extends = esp32_base
board = esp32-s3-wroom-1-n8r8
build_flags =
    ${env.build_flags}
    -D PINMAP_ESP32_S3_DEV_KIT_N8R8
    -D ENABLE_DISPLAY
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP

; ESP32-C3
[env:esp32-c3-super-mini]
extends = esp32_base
board = esp32-c3fn4
build_flags =
    ${env.build_flags}
    -D PINMAP_ESP32_C3_SUPER_MINI
    -D NO_BUTTONS
    -D ENABLE_CONSOLE
    -D MIN_CONFIG

; ESP32-P4
[env:waveshare-p4-module-dev-kit]
extends = esp32_base
board = esp32-p4nrw32
build_flags =
    ${env.build_flags}
    -D PINMAP_WAVESHARE_P4_MODULE_DEV_KIT
    -D SD_CARD
    -D ENABLE_DISPLAY
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP

[env:wt9932p4-tiny]
extends = esp32_base
board = esp32-p4nrw32
build_flags =
    ${env.build_flags}
    -D PINMAP_WT9932P4_TINY
    -D SD_CARD
    -D ENABLE_DISPLAY
    -D ENABLE_CONSOLE
    -D ENABLE_CONSOLE_TCP
